# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/ethio_lottery?schema=public"

# JWT
JWT_SECRET="your_jwt_secret_key_minimum_32_characters"
JWT_EXPIRES_IN="7d"

# bcrypt
BCRYPT_SALT_ROUNDS="12"

# Server
PORT="5000"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"

# Payment Providers
PAYMENT_PROVIDER="CBE"

# Additional settings