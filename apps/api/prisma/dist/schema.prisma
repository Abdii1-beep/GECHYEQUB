generator client {
  provider = "prisma-client-js"
  output   = "./dist/"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  SUPER_ADMIN
  LOTTERY_MANAGER
  FINANCE_OFFICER
  KYC_OFFICER
  DRAW_OFFICER
  AUDITOR
  CUSTOMER_SUPPORT
  CONTENT_MANAGER
}

enum DrawState {
  DRAFT
  SCHEDULED
  LOCKED
  DRAWING
  COMPLETED
  VERIFIED
  PUBLISHED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  REFUNDED
  DISPUTED
}

enum TicketStatus {
  RESERVED
  PENDING_PAYMENT
  PAID
  ACTIVE
  CANCELLED
  REFUNDED
  WINNING
  NON_WINNING
  INVALID
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum PaymentProvider {
  STRIPE
  CBE
  BIRR
}

// ==========================================
// CORE: USERS & AUTH
// ==========================================

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String?
  description String?
  isSensitive Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  status        String   @default("ACTIVE")
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])
  customerId        String?         @unique
  kycRecord         KycRecord       @relation(fields: [kycRecordId], references: [id])
  kycId             String?         @unique
  auditLogs         AuditLog[]
  customerProfileId String
  kycRecordId       String
}

model CustomerProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  fullName    String
  dateOfBirth DateTime?
  phone       String
  address     String?
  nationality String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  User        User[]
}

model KycRecord {
  id                   String    @id @default(uuid())
  userId               String    @unique
  fullName             String
  dateOfBirth          DateTime?
  phone                String
  email                String
  address              String
  nationalId           String?
  idVerificationStatus KycStatus @default(NOT_STARTED)
  idDocumentUrl        String?
  verificationDate     DateTime?
  verifiedBy           String?
  rejectionReason      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  User                 User[]
}

// ==========================================
// CAMPAIGN & VEHICLE MANAGEMENT
// ==========================================

model LotteryCampaign {
  id               String         @id @default(uuid())
  name             String
  slug             String         @unique
  description      String?
  systemName       String         @default("ETHIO CAR LOTTERY")
  status           CampaignStatus @default(DRAFT)
  ticketPrice      Int
  maxTickets       Int
  startDate        DateTime
  endDate          DateTime
  drawDate         DateTime?
  eligibilityRules Json           @default("{}")
  createdBy        String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  vehicles  Vehicle[]
  tickets   Ticket[]
  auditLogs AuditLog[]
}

model Vehicle {
  id                String           @id @default(uuid())
  make              String
  model             String
  year              Int
  color             String
  engineInfo        String?
  transmission      String?
  fuelType          String?
  vinChassisNumber  String           @unique
  registrationInfo  String?
  vehicleCondition  String           @default("AVAILABLE")
  location          String?
  declaredValue     Int
  status            String           @default("AVAILABLE")
  images            Json             @default("[]")
  documents         Json             @default("[]")
  campaignId        String? // Reference to LotteryCampaign
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  LotteryCampaign   LotteryCampaign? @relation(fields: [lotteryCampaignId], references: [id])
  lotteryCampaignId String?
}

// ==========================================
// TICKET MANAGEMENT
// ==========================================

model Ticket {
  id                String           @id @default(uuid())
  campaignId        String // Reference to LotteryCampaign
  customerId        String // Reference to User
  purchaseId        String           @unique
  paymentId         String?          @unique
  issueTimestamp    DateTime
  status            TicketStatus
  verificationHash  String
  qrCodeToken       String           @unique
  drawEligibility   Boolean          @default(false)
  drawId            String?          @unique
  drawResultHash    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  LotteryCampaign   LotteryCampaign? @relation(fields: [lotteryCampaignId], references: [id])
  lotteryCampaignId String?
}

// ==========================================
// PAYMENT SYSTEM
// ==========================================

model Order {
  id            String          @id @default(uuid())
  ticketId      String?         @unique
  amount        Int
  currency      String          @default("ETB")
  provider      PaymentProvider
  providerTxnId String?
  status        PaymentStatus   @default(INITIATED)
  paymentMethod String?
  failureReason String?
  receiptUrl    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model PaymentTransaction {
  id               String        @id @default(uuid())
  orderId          String        @unique
  amount           Int
  currency         String        @default("ETB")
  status           PaymentStatus
  responseMetadata Json          @default("{}")
  callbackStatus   String?
  receivedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

// ==========================================
// DRAW ENGINE
// ==========================================

model Draw {
  id                  String     @id @default(uuid())
  campaignId          String // Reference to LotteryCampaign
  state               DrawState  @default(DRAFT)
  eligibleTicketCount Int
  commitmentHash      String
  winningTicketId     String?    @unique
  drawTimestamp       DateTime?
  configuration       Json       @default("{}")
  verificationRecord  Json       @default("{}")
  auditLogs           AuditLog[]
}

model DrawEligibleTicket {
  id         String   @id @default(uuid())
  ticketId   String   @unique
  drawId     String
  orderIndex Int // Position in the eligible pool
  createdAt  DateTime @default(now())
}

model DrawResult {
  id                 String    @id @default(uuid())
  drawId             String    @unique
  drawNumber         Int
  drawHash           String
  verifiedAt         DateTime?
  verificationStatus String    @default("PENDING")
  createdAt          DateTime  @default(now())
}

// ==========================================
// WINNER MANAGEMENT
// ==========================================

model Winner {
  id                    String    @id @default(uuid())
  drawId                String // Reference to Draw
  ticketId              String // Reference to Ticket
  customerId            String // Reference to User
  verificationStatus    String    @default("SELECTED")
  notificationStatus    String    @default("PENDING")
  claimStatus           String    @default("NOT_CLAIMED")
  verificationDocuments Json      @default("{}")
  verificationTimestamp DateTime?
  approvalOfficer       String?
  rejectionReason       String?
  deliveryStatus        String    @default("PENDING")
  deliveredAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// ==========================================
// REFUNDS
// ==========================================

model Refund {
  id          String    @id @default(uuid())
  ticketId    String    @unique
  amount      Int
  currency    String    @default("ETB")
  reason      String
  status      String    @default("PENDING")
  processedAt DateTime?
  processedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ==========================================
// NOTIFICATIONS
// ==========================================

model Notification {
  id           String    @id @default(uuid())
  userId       String // Reference to User
  type         String
  title        String
  message      String
  data         Json      @default("{}")
  read         Boolean   @default(false)
  sentChannels Json      @default("[]")
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
}

// ==========================================
// FRAUD & SECURITY
// ==========================================

model FraudAlert {
  id             String    @id @default(uuid())
  userId         String? // Reference to User
  type           String
  severity       String    @default("MEDIUM")
  title          String
  description    String
  evidence       Json      @default("{}")
  status         String    @default("OPEN")
  investigatedBy String?
  resolvedAt     DateTime?
  resolvedReason String?
  createdAt      DateTime  @default(now())
}

model AuditLog {
  id                String           @id @default(uuid())
  userId            String // Reference to User
  role              Role
  action            String
  entity            String
  entityId          String
  timestamp         DateTime         @default(now())
  ipAddress         String?
  userAgent         String?
  requestId         String
  beforeValue       Json?
  afterValue        Json?
  result            String
  createdAt         DateTime         @default(now())
  User              User             @relation(fields: [userId], references: [id])
  LotteryCampaign   LotteryCampaign? @relation(fields: [lotteryCampaignId], references: [id])
  lotteryCampaignId String?
  Draw              Draw?            @relation(fields: [drawId], references: [id])
  drawId            String?
}

// Soft delete support
model SoftDeleteLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  deletedAt  DateTime
  deletedBy  String
  reason     String?
}
